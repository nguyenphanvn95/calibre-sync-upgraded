<?xml version="1.0" encoding="utf-8"?>
<!-- Menu duy nhat cho NavigationView, thay the 3 tab co dinh cu. Thu tu tu tren xuong: Device
     Library (quay ve thu vien tren may - khong co nut back rieng khi dang o tab khac nen can
     luon co mat o day), roi den thiet bi Calibre, Calibre Library, Calibre Libraries on GDrive,
     Cloud Sync, Settings/About sau 1 divider.

     "Cloud Sync" (nav_cloud_sync) khong con dieu huong thang sang tab Connection nua , no la 1
     muc dang accordion: mac dinh THU GON, bam vao se XOE ra danh sach cac nut cloud provider
     (group_cloud_sync_children, xem MainActivity#toggleCloudSyncSubmenu()), giong kieu accordion
     "Thu Vien" trong anh mau. app:actionLayout gan 1 mui ten chevron o cuoi dong, xoay 90 do khi
     xoe ra (xem res/layout/nav_drawer_expand_chevron.xml). Cac muc con (group_cloud_sync_children)
     mac dinh android:visible="false" , chi hien khi accordion dang xoe , va bam vao 1 muc con se
     tai su dung y het logic click cua the tuong ung trong ConnectionFragment#onProviderCardClick()
     (xem MainActivity#openCloudProviderFromDrawer()), khong viet lai flow OAuth/WebDAV moi. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <group android:checkableBehavior="single">
        <item
            android:id="@+id/nav_device_library"
            android:icon="@drawable/ic_tab_collection"
            android:title="@string/nav_device_library" />
        <item
            android:id="@+id/nav_calibre_device"
            android:icon="@drawable/ic_tab_connection"
            android:title="@string/nav_calibre_device" />
        <item
            android:id="@+id/nav_calibre_library"
            android:icon="@drawable/ic_tab_csync"
            android:title="@string/nav_calibre_library" />
        <item
            android:id="@+id/nav_calibre_gdrive_libraries"
            android:icon="@drawable/ic_provider_gdrive_opds_library"
            android:title="@string/nav_calibre_gdrive_libraries" />
        <item
            android:id="@+id/nav_cloud_sync"
            android:icon="@drawable/ic_menu_cloud_download"
            android:title="@string/nav_cloud_sync"
            app:actionLayout="@layout/nav_drawer_expand_chevron" />
    </group>
    <group
        android:id="@+id/group_cloud_sync_children"
        android:checkableBehavior="none">
        <item
            android:id="@+id/nav_cloud_google_drive"
            android:icon="@drawable/ic_provider_google_drive"
            android:title="@string/cloud_type_google_drive"
            android:visible="false" />
        <item
            android:id="@+id/nav_cloud_onedrive"
            android:icon="@drawable/ic_provider_onedrive"
            android:title="@string/cloud_card_onedrive"
            android:visible="false" />
        <item
            android:id="@+id/nav_cloud_box"
            android:icon="@drawable/ic_provider_box"
            android:title="@string/cloud_card_box"
            android:visible="false" />
        <item
            android:id="@+id/nav_cloud_dropbox"
            android:icon="@drawable/ic_provider_dropbox"
            android:title="@string/cloud_card_dropbox"
            android:visible="false" />
        <item
            android:id="@+id/nav_cloud_webdav_ftp"
            android:icon="@drawable/ic_provider_webdav"
            android:title="@string/cloud_card_webdav_ftp"
            android:visible="false" />
    </group>
    <item android:title="">
        <menu>
            <!-- Muc moi mo ProgressActivity - thong ke thoi gian doc cong don toan thu vien
                 (xem ProgressActivity/DailyReadingStatsStore). Dat truoc Settings, cung 1 group
                 voi Settings/What's New/Thoat. -->
            <item
                android:id="@+id/nav_progress"
                android:icon="@drawable/ic_menu_progress"
                android:title="@string/nav_progress" />
            <item
                android:id="@+id/nav_settings"
                android:icon="@drawable/ic_menu_settings"
                android:title="@string/menu_settings" />
            <!-- Truoc day la "About" (mo AlertDialog don gian chi co so version) — gio doi
                 thanh "What's New"/"Co gi moi", mo WhatsNewActivity hien changelog dang bullet
                 theo tung phien ban (xem MainActivity#showAboutDialog() da bi thay bang
                 startActivity(WhatsNewActivity)). Giu nguyen id nav_about de khong phai sua
                 them noi nao khac dang tham chieu R.id.nav_about. -->
            <item
                android:id="@+id/nav_about"
                android:icon="@drawable/ic_action_info"
                android:title="@string/nav_about" />
            <!-- Nut "Thoat" moi, dat ngay duoi "What's New" nhu anh mau — bam vao dong hoan
                 toan CalibreService (foreground service) roi ket thuc process, xem
                 MainActivity#exitApp(). -->
            <item
                android:id="@+id/nav_exit"
                android:icon="@drawable/ic_menu_exit"
                android:title="@string/nav_exit" />
        </menu>
    </item>
</menu>
