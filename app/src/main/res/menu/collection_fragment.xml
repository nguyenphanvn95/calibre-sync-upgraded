<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 2 group duoi day chi phuc vu HeaderOverflowMenu (popup 3 cham cua CollectionFragment):
         group_overflow_collection_main (xem/loc/sap xep/nhap sach) hien o tren, tach 1 vach
         ngang, roi den group_overflow_collection_other (dong bo/ngau nhien/tac vu nen) o duoi,
         xem CollectionFragment#onHeaderOverflowClick(). Khong doi thu tu hay logic
         onOptionsItemSelected() hien co. -->
    <group android:id="@+id/group_overflow_collection_main">
        <item
                android:id="@+id/menu_collection_tags"
                android:icon="@drawable/ic_menu_tags"
                android:title="@string/menu_collection_tags"
                android:showAsAction="ifRoom|withText"></item>

        <item
                android:id="@+id/menu_collection_sort_by"
                android:icon="@drawable/ic_menu_sort"
                android:title="@string/menu_collection_sort_by"
                android:showAsAction="never"></item>

        <item
                android:id="@+id/menu_search"
                android:title="@string/menu_search"
                android:icon="@drawable/ic_menu_search"
                android:showAsAction="ifRoom|collapseActionView"
                android:actionViewClass="android.widget.SearchView"
                />
        <item
                android:id="@+id/menu_collection_books"
                android:title="@string/menu_collection_books"
                android:icon="@drawable/ic_tab_collection"/>
        <!-- Was a nested <menu> submenu (List/Grid x3/Simple list/Carousel as a checkable group);
             Android rendered that as an anchored dropdown under the toolbar. Now a plain leaf item:
             tapping it opens ViewModePickerDialog instead, a centered floating dialog. -->
        <item
                android:id="@+id/menu_view_mode"
                android:title="@string/menu_view_mode"
                android:icon="@drawable/ic_menu_view_mode"
                android:showAsAction="ifRoom"></item>
        <!-- Dấu "+" trên toolbar Device Library: nhập sách thủ công từ file bất kỳ (SAF picker),
             xem CollectionFragment#openImportBookPicker(). showAsAction="always" để luôn hiện ngay
             bên trái nút overflow (3 chấm), thay vì bị đẩy vào overflow như phần lớn item khác ở
             file này. -->
        <item
                android:id="@+id/menu_import_book"
                android:title="@string/menu_import_book"
                android:icon="@drawable/ic_menu_add_book"
                android:showAsAction="always"></item>
    </group>
    <group android:id="@+id/group_overflow_collection_other">
        <item
                android:id="@+id/menu_auto_sync_now"
                android:title="@string/menu_device_library_auto_sync_never"
                android:icon="@drawable/ic_menu_cloud_upload"
                android:showAsAction="never"></item>
        <item
                android:id="@+id/menu_random_book"
                android:title="@string/menu_random_book"
                android:icon="@drawable/ic_menu_shuffle"
                android:showAsAction="never"></item>

        <item
                android:id="@+id/menu_background_jobs"
                android:title="@string/menu_background_jobs"
                android:icon="@drawable/ic_menu_background_jobs"
                android:showAsAction="never"></item>
    </group>
</menu>
