<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the floating "now playing" TTS panel (view_tts_floating_mini_player.xml),
     rounded corners + dark semi-transparent fill so it reads as a floating card over whatever
     screen it's overlaid on (Device Library, Calibre Library, book search, PDF reader), matching
     the reference screenshot's floating audio bar. -->
