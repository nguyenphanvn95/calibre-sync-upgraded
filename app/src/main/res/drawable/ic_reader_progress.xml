<?xml version="1.0" encoding="utf-8"?>
<!-- Mini progress-slider glyph for GotoLocationAction ("Tien do"), matching Readest's footer
     progress icon - a horizontal track with a thumb dot sitting slightly right of center, same
     placeholder-geometry spirit as the other reader icons in this package. Replaces the old
     android.R.drawable.ic_menu_mylocation (location pin) system icon, which no longer matched
     this action's new "jump to % via draggable seekbar" behaviour. -->
