<?xml version="1.0" encoding="utf-8"?>
<!-- Selector nen cho dong lua chon luong CPU: vien tim khi duoc chon (state_activated),
     nen xam trung tinh khi chua chon. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="#241F3D" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#7C6FF0" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1C1C1C" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#333333" />
        </shape>
    </item>
</selector>
