<?xml version="1.0" encoding="utf-8"?>
<!-- Mot dong lua chon so luong CPU trong dialog Sherpa TTS. isActivated cua root quyet dinh
     vien/nen to sang, xem selector bg_sherpa_thread_option_selector.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sherpa_thread_option_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_sherpa_thread_option_selector"
    android:padding="14dp">

    <ImageView
        android:id="@+id/sherpa_thread_option_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sherpa_thread_option_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/sherpa_thread_option_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/sherpa_thread_option_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/checkbox_on_background"
        android:contentDescription="@null" />

</LinearLayout>
