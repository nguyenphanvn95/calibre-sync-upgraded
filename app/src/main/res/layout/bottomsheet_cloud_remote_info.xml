<?xml version="1.0" encoding="utf-8"?>
<!--
  Bản nâng cấp UI (xem prompt-nang-cap-ui-va-import-device-library.md mục 1.4): thêm icon +
  card bo góc cho từng ô thống kê, đưa nút Đồng bộ vào MaterialButton có icon, style lại 2 nút
  hành động (Duyệt file = filled, Ngắt kết nối = outlined đỏ). GIỮ NGUYÊN mọi android:id so với
  bản cũ - CloudRemoteInfoBottomSheetFragment.java không đổi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvRemoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textSize="20sp"
        tools:text="Google Drive" />

    <!-- Hàng "Đồng bộ lần cuối" - bọc trong card bo góc thay vì hàng phẳng như trước.
         Tách thành 2 dòng con: dòng text (luôn full-width, không bị bóp) và dòng nút riêng
         bên dưới, canh phải. Trước đây text + 2 nút nằm chung 1 hàng ngang khiến tvLastSync
         (weight=1) bị co gần 0dp trên màn hình hẹp -> text xuống dòng từng ký tự -> card giãn
         cao bất thường. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sync_row_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLastSync"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorPrimary" />

            <ProgressBar
                android:id="@+id/pbSyncing"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Dòng nút - tách riêng bên dưới dòng text, canh phải, có thể xuống dòng tự nhiên
             giữa 2 nút nếu màn hình rất hẹp mà không kéo theo text bị bóp. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSync"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/cloud_remote_info_sync"
                android:textAllCaps="true"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_stat_sync"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp" />

            <!-- Nút "Check" dọn file/thư mục mồ côi trên cloud remote (sync_progress_out*.json rác,
                 thư mục books/<uuid>/ tombstone) - chỉ hiển thị khi CloudRemoteType hiện tại có
                 supportsDeviceLibrarySync() == true, xem CloudRemoteInfoBottomSheetFragment. Ẩn mặc
                 định (visibility gone) trong layout, fragment tự bật lên đúng điều kiện. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckOrphans"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/cloud_remote_info_check_orphans"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:visibility="gone"
                app:cornerRadius="10dp"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- 3 ô thống kê: Sách / Tác giả / Thẻ - Device Library cục bộ KHÔNG lưu Publisher/Series,
         xem MetadataDatabaseHelper#getLocalLibrarySummary (không đổi hành vi, chỉ đổi UI). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_book" />
            <TextView
                android:id="@+id/tvBookCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="12" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cloud_remote_info_books"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_person" />
            <TextView
                android:id="@+id/tvAuthorCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="18" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cloud_remote_info_authors"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_tag" />
            <TextView
                android:id="@+id/tvTagCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="41" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cloud_remote_info_tags"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseFiles"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/cloud_remote_info_browse_files"
            android:textAllCaps="true"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisconnect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cloud_remote_info_disconnect"
            android:textAllCaps="true"
            android:textColor="@color/color_action_destructive"
            app:cornerRadius="10dp"
            app:strokeColor="@color/color_action_destructive" />

    </LinearLayout>

</LinearLayout>
