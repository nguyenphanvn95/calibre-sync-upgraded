<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet chon "Muc tieu doc hang ngay" (DailyGoalPickerBottomSheet), mo tu card_daily_goal
     trong activity_progress.xml - 3 muc co dinh (De dang/Trung binh/Kho khan) + 1 muc "Gia tri
     cua ban" co stepper -/+ tuy chinh (anh 3), roi hang Luu/Huy o duoi cung dang 2 TextView (khop
     dung phong cach anh mau, khong phai Material Button chuan). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/progress_goal_picker_title"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorPrimary" />

    <RadioGroup
        android:id="@+id/goal_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <RadioButton
                android:id="@+id/radio_goal_easy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/progress_goal_easy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_goal_easy_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="10 phút" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <RadioButton
                android:id="@+id/radio_goal_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/progress_goal_medium"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_goal_medium_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="20 phút" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <RadioButton
                android:id="@+id/radio_goal_hard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/progress_goal_hard"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_goal_hard_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="30 phút" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <RadioButton
                android:id="@+id/radio_goal_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/progress_goal_custom"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_custom_minus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/progress_stepper_minus"
                android:textSize="20sp"
                android:textColor="@color/color_progress_accent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/text_custom_minutes"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                tools:text="10" />

            <TextView
                android:id="@+id/btn_custom_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/progress_stepper_plus"
                android:textSize="20sp"
                android:textColor="@color/color_progress_accent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/btn_goal_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_save"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/color_progress_accent"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_goal_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/progress_cancel"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
