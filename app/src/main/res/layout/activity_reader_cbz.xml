<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/cbz_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Old reader_close_button ImageButton removed in favour of the shared chrome overlay's
         "Đóng"/"Quit" controls - see spec section 5. The lightweight page-number indicator stays
         (it is distinct from, and complementary to, the chrome overlay's "NN%" progress label). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#88000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/cbz_page_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#FFFFFF"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

    </LinearLayout>

    <include layout="@layout/view_reader_chrome_overlay" />

</FrameLayout>
