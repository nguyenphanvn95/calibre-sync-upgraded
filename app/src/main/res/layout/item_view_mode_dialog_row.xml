<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the "Display" picker dialog (ViewModePickerDialog): icon on the left, label in
     the middle, a RadioButton on the right showing the current selection. Whole row is
     clickable (selectableItemBackground ripple) rather than just the radio button, so tapping
     anywhere on the row picks that option; matches the reference mock-up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_mode_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/view_mode_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/view_mode_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp" />

    <RadioButton
        android:id="@+id/view_mode_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorPrimary"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
