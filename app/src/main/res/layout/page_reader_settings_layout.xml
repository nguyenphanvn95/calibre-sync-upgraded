<?xml version="1.0" encoding="utf-8"?>
<!-- Noi dung tab "Bo cuc" cua ReaderSettingsSheet. Mot the duy nhat, dung het bang code
     (ReaderSettingsLayoutPage.kt qua ReaderSettingsRowBinder): gian dong, gian doan, thut dau
     dong, "Ghi de kieu cua sach" (mo khoa cac muc nang cao ben duoi no), gian tu, gian chu, can
     deu, gach noi tu, chia 2 cot, le trang. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="420dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/reader_settings_layout_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape_reader_settings_group_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
