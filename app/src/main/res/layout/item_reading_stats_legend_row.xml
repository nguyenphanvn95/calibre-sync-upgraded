<?xml version="1.0" encoding="utf-8"?>
<!--
  Legend for the "Chapter reading times" timeline bar (net.mrphan.calibre.reader.stats.
  ReadingTimelineBarView): one colored square + label per UnitStatus color, laid out as two rows
  of two so it never needs to wrap/measure dynamically. Colors are kept in sync by hand with
  ReadingTimelineBarView's companion constants (COLOR_ACTUAL, COLOR_CURRENT_MARKER/
  COLOR_ESTIMATED_CURRENT, COLOR_ESTIMATED_OTHER) since a plain View can't expose its Paint
  colors to a static layout resource.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="#4CAF50" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/reader_stats_legend_actual"
            android:textColor="#555555"
            android:textSize="12sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="#64B5F6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/reader_stats_legend_estimated"
            android:textColor="#555555"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="#FF9800" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/reader_stats_legend_current"
            android:textColor="#555555"
            android:textSize="12sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="#9E9E9E" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/reader_stats_legend_other"
            android:textColor="#555555"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
