        android:orientation="vertical"
        android:background="@drawable/shape_reader_settings_group_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
