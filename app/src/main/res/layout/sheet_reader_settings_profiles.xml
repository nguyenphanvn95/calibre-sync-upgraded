<?xml version="1.0" encoding="utf-8"?>
<!-- Bang "Cau hinh tao san" (ReaderSettingsProfilesSheet): danh sach preset dung san + preset
     nguoi dung tu luu, ben duoi la nut "Luu cau hinh hien tai...". Boc trong NestedScrollView
     de danh sach dai (nhieu preset tu tao) van cuon duoc ben trong BottomSheetDialogFragment. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reader_action_profiles"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/reader_settings_profiles_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/reader_settings_profiles_save_current"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reader_settings_profiles_save_current_action" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
