<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet dung chung cho ca nut Tu dien va Dich tren thanh cong cu boi den van ban
     (xem net.mrphan.calibre.reader.lookup.LookupBottomSheetFragment). Cau truc: tieu de, mot
     ProgressBar khi dang cho ket qua, mot container rong duoc do day TextView bang code (so
     luong nghia/dinh nghia thay doi tuy tu, khong the danh san trong XML), va mot hang nut
     "Thu lai" / "Mo trinh duyet" chi hien khi tra cuu that bai. Boc trong NestedScrollView vi
     ket qua tu dien co the dai (nhieu nghia theo nhieu tu loai). -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_reader_lookup_sheet_bg"
    android:maxHeight="480dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/shape_reader_sheet_handle" />

        <TextView
            android:id="@+id/lookup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/reader_selection_label_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/lookup_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lookup_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/lookup_error_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/lookup_retry_button"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lookup_retry" />

            <Button
                android:id="@+id/lookup_open_browser_button"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lookup_open_browser" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
