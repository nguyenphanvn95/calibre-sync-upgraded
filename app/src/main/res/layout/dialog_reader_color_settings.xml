<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheetDialog "Mau nen & Tuong phan": do sang man hinh + hang mau nen dat ten san + nut
     Light/Dark - xem prompt-nang-cap-mau-nen-tien-do-doc.md muc 3.1/4.9. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reader_color_settings_brightness"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_reader_theme_toggle"
            android:contentDescription="@null" />

        <SeekBar
            android:id="@+id/color_settings_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_reader_theme_toggle"
            android:contentDescription="@null" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reader_color_settings_color"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/color_settings_swatch_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/color_settings_background_opacity_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/color_settings_background_opacity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reader_background_opacity_label"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/color_settings_background_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/color_settings_mode_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_reader_theme_toggle"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_action_theme_toggle" />

</LinearLayout>
