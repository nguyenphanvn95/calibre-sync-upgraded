<?xml version="1.0" encoding="utf-8"?>
<!-- Grid cell for the Device Library tab (BookRecyclerAdapter, TYPE_GRID). No swipe actions
     here (a partial horizontal reveal on a narrow grid cell isn't good UX; swipe-to-reveal is
     only offered in the two list modes) — just the existing book_item_grid.xml content plus a
     checkbox overlay for multi-select, consistent with the other item layouts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp">

        <ImageView
            android:id="@+id/bi_thumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dumbbook"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/bi_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Title"
            android:textSize="12sp"
            android:textStyle="normal"
            android:lineSpacingMultiplier="0.95"
            app:layout_constraintTop_toBottomOf="@id/bi_thumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- % tien trinh doc, thay cho dong tac gia (bi_author) da bo di de khop Readest (grid
             chi hien tua de + %, khong co tac gia). An hoan toan khi khong co du lieu tien
             trinh, xem BookRecyclerAdapter. -->
        <TextView
            android:id="@+id/bi_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_horizontal"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/bi_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="42%" />

        <TextView
            android:id="@+id/bi_uuid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/bi_progress"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <CheckBox
        android:id="@+id/bi_select_checkbox"
        android:layout_width="@dimen/selection_checkbox_size"
        android:layout_height="@dimen/selection_checkbox_size"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
