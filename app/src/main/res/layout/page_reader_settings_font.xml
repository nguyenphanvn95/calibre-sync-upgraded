<?xml version="1.0" encoding="utf-8"?>
<!-- Noi dung tab "Phông chữ" cua ReaderSettingsSheet. Card duoc de trong va dung het bang code
     (ReaderSettingsFontPage.kt qua ReaderSettingsRowBinder) de kiem soat dung thu tu: co chu ->
     kieu chu (dam nhat) -> font chu (Spinner) -> "Ghi de kieu cua sach". -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="420dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/reader_settings_font_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape_reader_settings_group_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
